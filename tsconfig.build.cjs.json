{
  // Builds the CommonJS half of the package (`dist/cjs`): the same sources
  // and settings as `tsconfig.build.json`, emitted as CommonJS. The command
  // line interface (src/cli/) is left out: its executable is an ES module,
  // and nothing imports it.
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "commonjs",
    // `verbatimModuleSyntax` (on in tsconfig.json) refuses ES module syntax
    // when the output is CommonJS. It has done its job by then: the type
    // check and the ESM build run with it.
    "verbatimModuleSyntax": false,
    "outDir": "./dist/cjs"
  },
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/cli/**"]
}
