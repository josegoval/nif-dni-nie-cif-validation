---
// The project's stars on GitHub and downloads on npm in the last week, in
// the hero of the landing page, with the date they were fetched. They are
// fetched once per build (src/data/stats.ts): no request from the browser,
// no badge service, no JavaScript. A number the build couldn't get is left
// out, and its link stays, to the page where a visitor can see it.
import { Icon } from "@astrojs/starlight/components";
import {
  DOWNLOADS_URL,
  projectStats,
  STARS_URL,
} from "../../data/stats";
import { formatDate, formatNumber, langOf, stringsFor } from "../../i18n";

const lang = langOf(Astro.locals.starlightRoute.lang);
const t = stringsFor(lang).stats;
const { stars, downloads, date } = await projectStats();

// The strings get the number already formatted and wrapped, so each language
// can place it in its own word order; the markup is our own, not input.
const strong = (value: number) =>
  `<strong>${formatNumber(lang, value)}</strong>`;
const items = [
  {
    href: STARS_URL,
    icon: "star" as const,
    html: stars === null ? t.starsLink : t.stars(strong(stars), stars),
    live: stars !== null,
  },
  {
    href: DOWNLOADS_URL,
    icon: "npm" as const,
    html:
      downloads === null
        ? t.downloadsLink
        : t.downloads(strong(downloads), downloads),
    live: downloads !== null,
  },
];
const anyLive = items.some((item) => item.live);
---

<div class="stats" data-stats>
  <ul aria-label={t.label}>
    {
      items.map(({ href, icon, html, live }) => (
        <li>
          <a href={href} data-stat={icon} data-live={live ? "" : undefined}>
            <Icon name={icon} size="1.125rem" />
            <span set:html={html} />
          </a>
        </li>
      ))
    }
  </ul>
  {
    anyLive && (
      <p class="as-of" data-stats-date={date}>
        {t.asOf(formatDate(lang, date))}
      </p>
    )
  }
</div>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.25rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  a :global(svg) {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }
  span :global(strong) {
    color: var(--sl-color-white);
    font-weight: var(--brand-weight-semibold);
  }
  .as-of {
    margin: 0;
    color: var(--sl-color-gray-3);
  }
</style>
