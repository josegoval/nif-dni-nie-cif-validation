---
// The live validator. The page renders the form; validator.ts, a small
// vanilla script, runs the package's own validate() and its locale object
// for the page's language, in the browser. Without JavaScript the form is
// inert and a notice says so; the rest of the page doesn't need it.

import { officialSourcesUrl } from "../../data/spec";
import { langOf, stringsFor } from "../../i18n";

const lang = langOf(Astro.locals.starlightRoute.lang);
const t = stringsFor(lang).validator;
const types = ["DNI", "NIE", "CIF"] as const;
---

<section class="validator not-content" id="try" aria-labelledby="try-heading">
  <h2 id="try-heading">{t.heading}</h2>
  <p class="intro">{t.intro}</p>
  <div
    class="panel"
    data-validator
    data-lang={lang}
    data-spec={officialSourcesUrl(lang)}
    data-strings={JSON.stringify(t.ui)}
  >
    <label for="nif-input">{t.label}</label>
    <input
      id="nif-input"
      type="text"
      inputmode="text"
      autocomplete="off"
      autocapitalize="characters"
      spellcheck="false"
      maxlength="32"
      placeholder="12345678Z"
      aria-describedby="nif-hint"
      data-input
    />
    <p id="nif-hint" class="hint">{t.hint}</p>
    <fieldset class="generate" hidden data-generate>
      <legend class="sr-only">{t.generateLabel}</legend>
      {
        types.map((type) => (
          <button type="button" data-type={type}>
            {t.generate[type]}
          </button>
        ))
      }
    </fieldset>
    <div class="result" data-result>
      <p class="status" aria-live="polite" aria-atomic="true" data-status>
        {t.ui.empty}
      </p>
      <dl hidden data-details></dl>
    </div>
    {/* Hidden by validator.ts once it runs: shown without JavaScript, or if
        the script fails to load. */}
    <p class="noscript" data-noscript>{t.noscript}</p>
    <p class="note">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V11a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Zm-3 8V6a3 3 0 0 1 6 0v3H9Z"
        ></path></svg
      >
      {t.privacy}
    </p>
    <p class="note" hidden data-generated-note>{t.generatedNote}</p>
  </div>
</section>

{/* One entry point per language: a page downloads only its own locale. */}
{lang === "en" && <script src="./validator-en.ts"></script>}
{lang === "es" && <script src="./validator-es.ts"></script>}
{lang === "ca" && <script src="./validator-ca.ts"></script>}
{lang === "eu" && <script src="./validator-eu.ts"></script>}
{lang === "gl" && <script src="./validator-gl.ts"></script>}

<style>
  .validator {
    margin-block: 2rem 3rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-h2);
    color: var(--sl-color-white);
  }
  .intro {
    margin: 0 0 1.25rem;
    max-width: 45rem;
    color: var(--sl-color-gray-2);
  }
  .panel {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--site-border);
    border-radius: var(--brand-radius-lg);
    background: var(--site-surface);
  }
  label {
    font-weight: var(--brand-weight-semibold);
    color: var(--sl-color-white);
  }
  input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 2px solid var(--sl-color-gray-4);
    border-radius: var(--brand-radius-md);
    background: var(--site-well);
    color: var(--sl-color-white);
    font-family: var(--brand-font-mono);
    font-size: var(--sl-text-xl);
    letter-spacing: 0.05em;
  }
  input::placeholder {
    color: var(--sl-color-gray-3);
  }
  input:focus-visible {
    border-color: var(--sl-color-accent);
    outline-offset: 2px;
  }
  .hint,
  .note,
  .noscript {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .note {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .note[hidden] {
    display: none;
  }
  .note svg {
    flex-shrink: 0;
  }
  .generate {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .generate[hidden] {
    display: none;
  }
  .generate button {
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: var(--brand-radius-pill);
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: var(--brand-weight-semibold);
    cursor: pointer;
  }
  .generate button:hover {
    border-color: var(--sl-color-text-accent);
  }
  .result {
    padding: 1rem 1.25rem;
    border-radius: var(--brand-radius-md);
    background: var(--site-well);
    border-inline-start: 4px solid var(--sl-color-gray-4);
  }
  .result[data-valid="true"] {
    border-inline-start-color: var(--site-valid);
  }
  .result[data-valid="false"] {
    border-inline-start-color: var(--site-invalid);
  }
  .status {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-weight: var(--brand-weight-semibold);
  }
  .result[data-valid="true"] .status {
    color: var(--site-valid);
  }
  .result[data-valid="false"] .status {
    color: var(--site-invalid);
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.375rem 1.25rem;
    margin: 0.875rem 0 0;
    font-size: var(--sl-text-sm);
  }
  dl[hidden] {
    display: none;
  }
  dl :global(dt) {
    color: var(--sl-color-gray-3);
  }
  dl :global(dd) {
    margin: 0;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  dl :global(code) {
    font-family: var(--brand-font-mono);
    font-size: var(--sl-text-sm);
  }
  dl :global(a) {
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 30rem) {
    .panel {
      padding: 1rem;
    }
    dl {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
    dl :global(dd) {
      margin-block-end: 0.5rem;
    }
  }
</style>
