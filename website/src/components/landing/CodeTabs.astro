---
// Code samples in tabs that work without JavaScript: the tabs are a radio
// group (arrow keys move between them), and CSS shows the selected panel.
import { Code } from "@astrojs/starlight/components";
import { snippetsFor } from "../../data/snippets";
import { langOf, stringsFor } from "../../i18n";

const lang = langOf(Astro.locals.starlightRoute.lang);
const t = stringsFor(lang).code;
const snippets = snippetsFor(lang, t);
const tabs = [
  { id: "basic", label: t.tabs.basic, code: snippets.basic },
  { id: "validate", label: t.tabs.validate, code: snippets.validate },
  { id: "zod", label: t.tabs.zod, code: snippets.zod },
  { id: "generators", label: t.tabs.generators, code: snippets.generators },
];
---

<section class="code not-content" aria-labelledby="code-heading">
  <h2 id="code-heading">{t.heading}</h2>
  <p class="intro">{t.intro}</p>
  <div class="tabs">
    <fieldset>
      <legend class="sr-only">{t.tabsLabel}</legend>
      {
        tabs.map((tab, index) => (
          <>
            <input
              type="radio"
              name="code-tab"
              id={`code-tab-${tab.id}`}
              value={tab.id}
              checked={index === 0}
              class="sr-only"
            />
            <label for={`code-tab-${tab.id}`}>{tab.label}</label>
          </>
        ))
      }
    </fieldset>
    {
      tabs.map((tab) => (
        <div class="panel" data-panel={tab.id}>
          <Code code={tab.code} lang="ts" />
        </div>
      ))
    }
  </div>
</section>

<style>
  .code {
    margin-block: 3rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-h2);
    color: var(--sl-color-white);
  }
  .intro {
    margin: 0 0 1.25rem;
    max-width: 45rem;
    color: var(--sl-color-gray-2);
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--site-border);
  }
  label {
    padding: 0.5rem 1rem;
    border-bottom: 3px solid transparent;
    color: var(--sl-color-gray-3);
    font-weight: var(--brand-weight-semibold);
    cursor: pointer;
  }
  label:hover {
    color: var(--sl-color-white);
  }
  input:checked + label {
    border-bottom-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  input:focus-visible + label {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
    border-radius: var(--brand-radius-sm);
  }
  /* A browser without :has() shows every sample, one after the other. */
  @supports selector(:has(*)) {
    .panel {
      display: none;
    }
    .tabs:has(#code-tab-basic:checked) [data-panel="basic"],
    .tabs:has(#code-tab-validate:checked) [data-panel="validate"],
    .tabs:has(#code-tab-zod:checked) [data-panel="zod"],
    .tabs:has(#code-tab-generators:checked) [data-panel="generators"] {
      display: block;
    }
  }
</style>
