---
// The entry points of the package, from the `exports` map of its
// package.json, each linked to its page of the API reference (generated by
// TypeDoc, plugins/api-reference.mjs).
import pkg from "../../../../package.json";
import { langOf, localePath, stringsFor } from "../../i18n";
import TableScroll from "./TableScroll.astro";

const lang = langOf(Astro.locals.starlightRoute.lang);
const t = stringsFor(lang).docs.entryPoints;
const PACKAGE = pkg.name;
const LIBRARIES: Record<string, string> = {
  zod: "Zod 4",
  valibot: "Valibot 1",
  yup: "Yup 1",
};

const rows = Object.entries(pkg.exports)
  .filter(([, value]) => typeof value === "object")
  .map(([key]) => {
    const sub = key.slice(2);
    const specifier = sub === "" ? PACKAGE : `${PACKAGE}/${sub}`;
    let contents: string;
    if (sub === "") contents = t.main;
    else if (sub.startsWith("locales/")) {
      const code = sub.slice("locales/".length) as keyof typeof t.languages;
      const language = t.languages[code];
      if (!language) throw new Error(`No name for the language ${code}`);
      contents = t.locale(language);
    } else if (sub === "generate") contents = t.generate;
    else {
      const library = LIBRARIES[sub];
      if (!library) throw new Error(`No description for ${specifier}`);
      contents = t.schemas(library);
    }
    return {
      specifier,
      href: localePath(lang, `reference/api/${specifier}/`),
      contents,
    };
  });
---

<TableScroll labelledby="entry-points-caption">
  <table>
    <caption id="entry-points-caption">{t.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.entryPoint}</th>
        <th scope="col">{t.contents}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">
              <a href={row.href}>
                <code>{row.specifier}</code>
              </a>
            </th>
            <td>{row.contents}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</TableScroll>
