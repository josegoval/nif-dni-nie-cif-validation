---
// Starlight's footer (pagination and the rest), followed by the project
// links on every page.
import Default from "@astrojs/starlight/components/Footer.astro";
import { langOf, stringsFor } from "../../i18n";

const t = stringsFor(langOf(Astro.locals.starlightRoute.lang)).footer;
const repo = "https://github.com/josegoval/nif-dni-nie-cif-validation";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
  { href: repo, text: t.github },
  { href: "https://www.npmjs.com/package/nif-dni-nie-cif-validation", text: t.npm },
  { href: `${repo}/blob/master/LICENSE`, text: t.license },
  { href: `${repo}/blob/master/SPEC.md`, text: t.spec },
  { href: `${base}coverage/`, text: t.coverage },
  { href: `${base}llms.txt`, text: t.llms },
  { href: "https://www.buymeacoffee.com/josegoval", text: t.sponsor },
];
---

<Default />
<nav class="site-footer not-content" aria-label={t.label}>
  <ul>
    {links.map(({ href, text }) => <li><a href={href}>{text}</a></li>)}
  </ul>
  <p>{t.madeBy}</p>
</nav>

<style>
  .site-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--site-border);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--sl-color-gray-2);
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--sl-color-text-accent);
  }
  p {
    margin: 0;
  }
</style>
