{
  "$description": "Design tokens for nif-dni-nie-cif-validation. Format follows the W3C Design Tokens draft ($value / $type).",
  "color": {
    "$type": "color",
    "ink": { "$value": "#0F172A", "$description": "Primary text, wordmark and bars on light. Dark background." },
    "ink-800": { "$value": "#1E293B", "$description": "Raised surfaces on dark (install pill, cards)." },
    "rojo": { "$value": "#C8102E", "$description": "Primary. Control tile, links and emphasis on light." },
    "rojo-400": { "$value": "#F2475E", "$description": "Red text and links on Ink (4.96:1). Never used for the tile." },
    "gualda": { "$value": "#FFC72C", "$description": "Accent. On Ink only, or as a fill behind Ink text. Never text on light." },
    "paper": { "$value": "#FAFAF7", "$description": "Light background. Check mark and text on Rojo/Ink." },
    "slate-600": { "$value": "#475569", "$description": "Secondary text on light (7.25:1 on Paper)." },
    "slate-400": { "$value": "#94A3B8", "$description": "Secondary text on dark (6.96:1 on Ink)." },
    "slate-200": { "$value": "#E2E8F0", "$description": "Hairlines and borders on light." }
  },
  "theme": {
    "light": {
      "background": { "$type": "color", "$value": "{color.paper}" },
      "text": { "$type": "color", "$value": "{color.ink}" },
      "text-muted": { "$type": "color", "$value": "{color.slate-600}" },
      "accent": { "$type": "color", "$value": "{color.rojo}" },
      "tile": { "$type": "color", "$value": "{color.rojo}" },
      "on-tile": { "$type": "color", "$value": "{color.paper}" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "{color.ink}" },
      "surface": { "$type": "color", "$value": "{color.ink-800}" },
      "text": { "$type": "color", "$value": "{color.paper}" },
      "text-muted": { "$type": "color", "$value": "{color.slate-400}" },
      "accent": { "$type": "color", "$value": "{color.rojo-400}" },
      "highlight": { "$type": "color", "$value": "{color.gualda}" },
      "tile": { "$type": "color", "$value": "{color.rojo}" },
      "on-tile": { "$type": "color", "$value": "{color.paper}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Wordmark and headings. The logo uses it as outlines." },
    "body": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Body copy, tagline." },
    "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Code, install commands and ID samples." }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "radius": {
    "$type": "dimension",
    "tile-ratio": { "$type": "number", "$value": 0.25, "$description": "Every tile's corner radius is 25 % of its side (6 on the 24-unit grid)." },
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "12px" },
    "pill": { "$value": "9999px" }
  },
  "space": {
    "$type": "dimension",
    "$description": "4 px base. Logo geometry uses a 24-unit grid; 24 px = 1 module.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "logo": {
    "grid": { "$type": "number", "$value": 24, "$description": "Units per module. Mark = 48 x 24 (2 modules)." },
    "clear-space": { "$type": "number", "$value": 0.5, "$description": "Minimum clear space = 0.5 x mark height (half a tile) on every side." },
    "min-mark-height": { "$type": "dimension", "$value": "16px" },
    "min-favicon": { "$type": "dimension", "$value": "16px" },
    "min-wordmark-width": { "$type": "dimension", "$value": "200px" },
    "min-lockup-horizontal-width": { "$type": "dimension", "$value": "320px" },
    "min-lockup-stacked-width": { "$type": "dimension", "$value": "200px" }
  }
}
