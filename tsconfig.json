{
  // Used by `pnpm typecheck` and by editors. It covers the library, the tests
  // and the Vitest config, and emits nothing. `tsconfig.build.json` extends it
  // to build `dist/`.
  "compilerOptions": {
    "target": "es2016",
    // The package has no "type" field, so Node treats .ts/.js files as
    // CommonJS and `nodenext` emits CommonJS for them.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "noEmit": true,
    "declaration": true,
    // `@types/*` packages are not loaded implicitly (TypeScript 7 default).
    "types": [],
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Vitest transpiles every file on its own.
    "isolatedModules": true
    // `verbatimModuleSyntax` is off for now: with it, ESM `import`/`export`
    // syntax can't be emitted as CommonJS. Revisit it with the dual ESM/CJS
    // build (#48).
  },
  "include": ["src/**/*", "vitest.config.mts"]
}
