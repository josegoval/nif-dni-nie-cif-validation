{
  // Used by `pnpm typecheck` and by editors. It covers the library, the tests
  // and the Vitest config, and emits nothing. `tsconfig.build.json` extends it
  // to build `dist/`.
  "compilerOptions": {
    "target": "es2016",
    // The sources import each other without file extensions, which bundler
    // resolution allows. scripts/build.mjs adds the extensions to the output
    // (.mjs or .cjs). The CommonJS build overrides `module`.
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "declaration": true,
    // `@types/*` packages are not loaded implicitly (TypeScript 7 default).
    "types": [],
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Vitest transpiles every file on its own.
    "isolatedModules": true,
    // `import type` for types, so the output keeps exactly the imports the
    // sources write. The CommonJS build turns it off (tsconfig.build.cjs.json).
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "vitest.config.mts"]
}
