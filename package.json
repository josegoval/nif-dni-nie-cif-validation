{
  "name": "nif-dni-nie-cif-validation",
  "version": "1.0.10",
  "description": "Validate NIF, DNI, NIE and CIF documents easily.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "readme": "README.md",
  "keywords": [
    "nif",
    "dni",
    "nie",
    "cif",
    "nif validation",
    "dni validation",
    "nie validation",
    "cif validation",
    "nif-dni-nie-cif-validation"
  ],
  "files": [
    "/dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josegoval/nif-dni-nie-cif-validation.git"
  },
  "author": "josegoval <josegovalmusic@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "husky",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "spell": "cspell --no-progress",
    "spec:check": "node scripts/check-spec-rules.mjs",
    "bench": "pnpm build && node bench/run.mjs",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "cspell": "^10.3.4",
    "husky": "^9.1.7",
    "nif-v1": "npm:nif-dni-nie-cif-validation@1.0.11",
    "semantic-release": "^25.0.9",
    "tinybench": "^6.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
