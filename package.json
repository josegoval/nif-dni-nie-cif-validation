{
  "name": "nif-dni-nie-cif-validation",
  "version": "2.1.0",
  "description": "Validates Spanish NIF, DNI, K/L/M, NIE and CIF numbers against the official rules (BOE, AEAT): 0 dependencies, typed, ESM and CommonJS, input normalization, errors in 5 languages, test-data generators and Zod, Valibot and Yup schemas.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.cts",
  "bin": {
    "nif-dni-nie-cif-validation": "dist/esm/cli/bin.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./locales/en": {
      "import": {
        "types": "./dist/esm/locales/en.d.mts",
        "default": "./dist/esm/locales/en.mjs"
      },
      "require": {
        "types": "./dist/cjs/locales/en.d.cts",
        "default": "./dist/cjs/locales/en.cjs"
      }
    },
    "./locales/es": {
      "import": {
        "types": "./dist/esm/locales/es.d.mts",
        "default": "./dist/esm/locales/es.mjs"
      },
      "require": {
        "types": "./dist/cjs/locales/es.d.cts",
        "default": "./dist/cjs/locales/es.cjs"
      }
    },
    "./locales/ca": {
      "import": {
        "types": "./dist/esm/locales/ca.d.mts",
        "default": "./dist/esm/locales/ca.mjs"
      },
      "require": {
        "types": "./dist/cjs/locales/ca.d.cts",
        "default": "./dist/cjs/locales/ca.cjs"
      }
    },
    "./locales/eu": {
      "import": {
        "types": "./dist/esm/locales/eu.d.mts",
        "default": "./dist/esm/locales/eu.mjs"
      },
      "require": {
        "types": "./dist/cjs/locales/eu.d.cts",
        "default": "./dist/cjs/locales/eu.cjs"
      }
    },
    "./locales/gl": {
      "import": {
        "types": "./dist/esm/locales/gl.d.mts",
        "default": "./dist/esm/locales/gl.mjs"
      },
      "require": {
        "types": "./dist/cjs/locales/gl.d.cts",
        "default": "./dist/cjs/locales/gl.cjs"
      }
    },
    "./generate": {
      "import": {
        "types": "./dist/esm/generate/index.d.mts",
        "default": "./dist/esm/generate/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/generate/index.d.cts",
        "default": "./dist/cjs/generate/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/esm/zod/index.d.mts",
        "default": "./dist/esm/zod/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/zod/index.d.cts",
        "default": "./dist/cjs/zod/index.cjs"
      }
    },
    "./valibot": {
      "import": {
        "types": "./dist/esm/valibot/index.d.mts",
        "default": "./dist/esm/valibot/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/valibot/index.d.cts",
        "default": "./dist/cjs/valibot/index.cjs"
      }
    },
    "./yup": {
      "import": {
        "types": "./dist/esm/yup/index.d.mts",
        "default": "./dist/esm/yup/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/yup/index.d.cts",
        "default": "./dist/cjs/yup/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "locales/*": [
        "./dist/cjs/locales/*.d.cts"
      ],
      "generate": [
        "./dist/cjs/generate/index.d.cts"
      ],
      "zod": [
        "./dist/cjs/zod/index.d.cts"
      ],
      "valibot": [
        "./dist/cjs/valibot/index.d.cts"
      ],
      "yup": [
        "./dist/cjs/yup/index.d.cts"
      ]
    }
  },
  "sideEffects": false,
  "readme": "README.md",
  "keywords": [
    "nif",
    "dni",
    "nie",
    "cif",
    "nif validation",
    "dni validation",
    "nie validation",
    "cif validation",
    "spain",
    "spanish",
    "tax id",
    "vat",
    "aeat",
    "validator",
    "validation",
    "typescript",
    "zod",
    "valibot",
    "yup",
    "validar dni",
    "validar nif",
    "nif españa",
    "nif-dni-nie-cif-validation"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josegoval/nif-dni-nie-cif-validation.git"
  },
  "homepage": "https://josegoval.github.io/nif-dni-nie-cif-validation/",
  "bugs": {
    "url": "https://github.com/josegoval/nif-dni-nie-cif-validation/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://www.buymeacoffee.com/josegoval"
  },
  "author": "josegoval <josegovalmusic@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "valibot": "^1.0.0",
    "yup": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "husky",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "spell": "cspell --no-progress",
    "spec:check": "node scripts/check-spec-rules.mjs",
    "spec:sources": "node scripts/spec-sources.mjs",
    "spec:sources:update": "node scripts/spec-sources.mjs --update && biome format --write spec-sources.json",
    "bench": "pnpm build && node bench/run.mjs",
    "bench:competitors": "pnpm build && node bench/run-competitors.mjs",
    "bench:report": "node bench/report.mjs",
    "readme:bench": "node scripts/readme-bench.mjs",
    "docs:llms": "node scripts/llms-full.mjs",
    "docs:jsdoc": "pnpm build && node scripts/check-jsdoc.mjs",
    "smoke": "node scripts/smoke.mjs",
    "examples:pack": "node scripts/pack-for-examples.mjs",
    "examples:install": "pnpm examples:pack && pnpm --dir examples install",
    "examples:check": "pnpm --dir examples --recursive --filter \"!./deno\" --filter \"!./bun\" run check",
    "format": "biome check --write .",
    "size": "pnpm build && size-limit",
    "check:es": "pnpm build && es-check es2016 \"dist/cjs/**/*.cjs\" --checkFeatures && es-check es2016 \"dist/esm/**/*.mjs\" --module --checkFeatures"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-es-es": "^3.0.8",
    "@kreyo/nif-validator": "0.1.0",
    "@maistik/validate-nif": "2.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@size-limit/esbuild": "^14.1.0",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "better-dni": "4.4.2",
    "cspell": "^10.3.4",
    "dni-js": "1.0.0",
    "es-check": "^9.8.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsvat": "2.5.4",
    "nif-v1": "npm:nif-dni-nie-cif-validation@1.0.11",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.1.0",
    "spain-id": "1.1.14",
    "stdnum": "^1.12.6",
    "tinybench": "^6.2.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "validator": "13.15.35",
    "vitest": "^5.0.2",
    "yup": "^1.7.1",
    "zod": "^4.6.5"
  }
}
